rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Minimal user directory: only display name and createdAt are stored here.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string;
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId','callerUid','callerName','calleeUid','mode','status','offer','createdAt'])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.mode in ['audio','video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is map
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members
        && request.resource.data.calleeUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      allow update: if signedIn()
        && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid)
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','acceptedAt','endedAt'])
        && (request.auth.uid == resource.data.calleeUid || request.resource.data.status == 'ended');
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn()
          && candidateCollection in ['callerCandidates','calleeCandidates']
          && exists(/databases/$(database)/documents/calls/$(callId))
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid
              || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid);
        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.lastMessage is string;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['text', 'senderUid', 'senderName', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }
  }
}
